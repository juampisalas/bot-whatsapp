# Conexión a Postgres. El puerto 5433 lo publica docker-compose.
DATABASE_URL=postgres://bot:bot@localhost:5433/botwhatsapp
DATABASE_URL_TEST=postgres://bot:bot@localhost:5433/botwhatsapp_test

# Proveedor de mensajería activo: whatsapp | fake
PROVIDER=whatsapp

# Credenciales de sesión de WhatsApp y adjuntos descargados
WHATSAPP_AUTH_DIR=./data/wa-auth
MEDIA_DIR=./data/media
# Optional: digits with country code (e.g. 54911…). When set, link with a pairing
# code instead of a QR. Leave empty to use QR.
WHATSAPP_PHONE_NUMBER=

# Conversación de control. Para conseguir el identificador:
# bun run src/index.ts list-conversations
CONTROL_PROVIDER=whatsapp
CONTROL_CONVERSATION_ID=

# Máximo de mensajes retenidos en memoria si Postgres no responde
CAPTURE_BUFFER_MAX=1000

# Hard deadline for the whole shutdown sequence (ms). Default 15000.
SHUTDOWN_TIMEOUT_MS=15000

# El alcance de la captura no se configura acá: vive en las tablas capture_policy y
# capture_rules, y hoy solo se edita con SQL. Sin fila, se captura todo. Ver el README.

TIMEZONE=America/Argentina/Buenos_Aires
LOG_LEVEL=info

# LLM: ollama (default; must be running) | openai | anthropic | deepseek
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.6:35b-a3b
# Base URL for Ollama (or OpenAI-compatible endpoints)
LLM_BASE_URL=http://127.0.0.1:11434
# Embedding model (768 dims; default matches messages.embedding)
EMBEDDING_MODEL=embeddinggemma:300m
# API keys for cloud providers (optional when using ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Local audio transcription (faster-whisper + ffmpeg). Requires:
#   brew install ffmpeg
#   pip install faster-whisper
# Set WHISPER_ENABLED=false to skip voice-note transcription.
WHISPER_ENABLED=true
WHISPER_MODEL=medium
WHISPER_LANGUAGE_CONFIDENCE=0.80
FFMPEG_PATH=ffmpeg
WHISPER_PYTHON=python3
# WHISPER_SCRIPT=./scripts/whisper_transcribe.py
